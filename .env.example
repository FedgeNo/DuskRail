# Copy to .env and fill in real values. .env is gitignored.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=duskrail
DB_USERNAME=duskrail
# Required. The installer generates a random value interactively when left
# blank; unattended installs must supply DUSKRAIL_DB_PASSWORD in their
# environment rather than committing a credential here.
DB_PASSWORD=
# A name under .localhost resolves to this machine in every modern browser
# (and on systemd-resolved systems, for every program) with no /etc/hosts
# entry at all. Any other hostname needs one, and the installer prints it.
SITE_URL=https://duskrail.localhost
SITE_TITLE=DuskRail
# password_hash() output for the single operator login - the crawl controls sit
# behind it, searching does not. Written by `php bin/install.php`, which asks
# for the password and hashes it - never store the password itself here. Blank
# means nobody can sign in to run the crawl.
AUTH_PASSWORD_HASH=
# How many crawler workers run at once. Each opens its own tab in the one
# shared headless Chrome instance. Crawling is almost entirely waiting on the
# network - every fetch is a cold lookup and handshake to a host the
# politeness delay guarantees won't be revisited soon - so this is the main
# throughput lever, but returns are sublinear once the connection itself is
# the constraint, and too many tabs in one browser starts producing hangs.
# Measure on the machine rather than assuming: raise it, watch items/hour and
# the hang count on watch.php. Takes effect on the next start of the crawler
# manager; each slot's state file lives in var/ and is created on demand.
WORKER_COUNT=6
# Leave blank to autodetect (chromium-browser, google-chrome, chromium,
# google-chrome-stable, checked in that order on $PATH).
CHROME_BINARY=
