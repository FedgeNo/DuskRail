# Copy to .env and fill in real values. .env is gitignored.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=duskrail
DB_USERNAME=duskrail
DB_PASSWORD=change-me
# A name under .localhost resolves to this machine in every modern browser
# (and on systemd-resolved systems, for every program) with no /etc/hosts
# entry at all. Any other hostname needs one, and the installer prints it.
SITE_URL=https://duskrail.localhost
SITE_TITLE=DuskRail
# password_hash() output for the single operator login - the crawl controls sit
# behind it, searching does not. Written by `php bin/install.php`, which asks
# for the password and hashes it - never store the password itself here. Blank
# means nobody can sign in to run the crawl.
AUTH_PASSWORD_HASH=
# How many crawler workers run at once. Each opens its own tab in the one
# shared headless Chrome instance, so this trades crawl throughput against
# the memory and CPU those tabs cost - pick it for the machine, not the core
# count. Takes effect on the next start of the crawler manager; each slot's
# state file lives in var/ and is created on demand.
WORKER_COUNT=3
# Leave blank to autodetect (chromium-browser, google-chrome, chromium,
# google-chrome-stable, checked in that order on $PATH).
CHROME_BINARY=
