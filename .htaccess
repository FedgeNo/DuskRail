<IfModule mod_rewrite.c>
    RewriteEngine On

    # THUMBNAIL_DIRECTORY is linked here by the installer. Existing files
    # stay entirely in Apache; only a miss reaches the on-demand endpoint.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^thumbnails/[0-9]{2}/[0-9]{2}/[0-9]{2}/([0-9]+)\.jpg$ thumbnail.php?item=$1 [L]
</IfModule>
